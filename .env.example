# ==============================================================================
# Between Sessions — Environment Variables Configuration Template
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# ── DynamoDB Configuration ───────────────────────────────────────────────────
TABLE_NAME=BetweenSessionsTable
# For host/local express: http://127.0.0.1:8000
# For SAM Local container: http://host.containers.internal:8000
# For AWS Cloud deployment: leave unset (defaults to native AWS DynamoDB SDK)
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=us-east-1

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=between-sessions-secret-key-2026

# ── Email Delivery Configuration ─────────────────────────────────────────────
# Options: mock | ses | mailtrap
EMAIL_PROVIDER=mock
APP_BASE_URL=http://localhost:5173

# Amazon SES Configuration (used when EMAIL_PROVIDER=ses)
SES_FROM_EMAIL=sanctuary@betweensessions.com

# Mailtrap SMTP Credentials (used when EMAIL_PROVIDER=mailtrap)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user_here
MAILTRAP_SMTP_PASS=your_mailtrap_pass_here

# ── Clinical AI & Decision Support Pipeline ──────────────────────────────────
# Options: huggingface | mock
AI_PROVIDER=huggingface
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional: if omitted, system automatically falls back to deterministic MockLLM
HF_API_KEY=your_huggingface_token_here

# ── Frontend Configuration (Vite) ────────────────────────────────────────────
# Set to API Gateway root URL in production (e.g. https://xyz.execute-api.us-east-1.amazonaws.com/Prod/api/v1)
VITE_API_BASE=/api/v1
